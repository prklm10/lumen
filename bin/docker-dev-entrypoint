#!/bin/bash -e
# Entrypoint for the dev containers in compose.dev.yml.
#   web  → install missing gems, prepare the database, run Rails on :3000
#   vite → install npm packages when package-lock.json changed, run the Vite dev server on :3036
#   anything else (bin/rails test, bash, …) runs as-is once gems are installed

case "$1" in
  web)
    bundle check > /dev/null || bundle install
    rm -f tmp/pids/server.pid
    bin/rails db:prepare
    exec bin/rails server -b 0.0.0.0 -p 3000
    ;;
  vite)
    lock_sha=$(sha1sum package-lock.json | cut -d' ' -f1)
    if [ "$(cat node_modules/.lock-sha 2> /dev/null)" != "$lock_sha" ]; then
      npm ci --no-audit --no-fund
      echo "$lock_sha" > node_modules/.lock-sha
    fi
    exec npx vite
    ;;
  *)
    bundle check > /dev/null || bundle install
    exec "$@"
    ;;
esac
